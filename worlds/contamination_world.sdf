      </link>
    </model>
    
    <model name="rock_2">
      <static>true</static>
      <pose>28 -18 0.5 0.2 -0.1 1.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>1.0</radius></sphere></geometry>
