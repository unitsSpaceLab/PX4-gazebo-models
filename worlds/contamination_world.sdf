    <!-- ============================================ -->
    <!-- HAZARD BARRELS - Near contamination source  -->
    <!-- ============================================ -->
    
    <model name="barrel_cluster">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      
      <link name="barrel_1">
        <pose>10 -6 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
        </collision>
