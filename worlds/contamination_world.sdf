      </link>
    </model>
    
    <!-- Rover Spawn Pad -->
    <model name="rover_spawn_pad">
      <static>true</static>
      <pose>-25 15 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>2.0</radius><length>0.04</length></cylinder>
          </geometry>
          <material>
