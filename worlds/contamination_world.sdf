    <!-- ============================================ -->
    <!-- ROCKS - Navigation obstacles                -->
    <!-- ============================================ -->
    
    <model name="rock_1">
      <static>true</static>
      <pose>-12 8 0.4 0.1 0.2 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.8</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.8</radius></sphere></geometry>
          <material>
