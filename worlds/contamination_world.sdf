    <!-- ============================================ -->
    <!-- SPAWN PADS - Visual markers                 -->
    <!-- ============================================ -->
    
    <!-- Drone Spawn Pad -->
    <model name="drone_spawn_pad">
      <static>true</static>
      <pose>-25 20 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>2.0</radius><length>0.04</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.4 0.8 1</ambient>
            <diffuse>0.3 0.5 0.9 1</diffuse>
          </material>
