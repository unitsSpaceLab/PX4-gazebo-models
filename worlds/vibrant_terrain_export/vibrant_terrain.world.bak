<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="vibrant_terrain_world">
    <!-- Include the sun with default values -->


    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <thread_position_correction>true</thread_position_correction>
          <island_threads>8</island_threads>  <!-- Set to number of CPU cores available -->
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>



    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ambient light -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sky appearance -->
    <sky>
      <clouds>
        <speed>12</speed>
      </clouds>
    </sky>

    <!-- terrain_red -->
    <model name="terrain_red">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="terrain_red_link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://vibrant_terrain_export/terrain_red.dae</uri>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>120.0</mu>
                <mu2>100.0</mu2>
                <fdir1>1 0 0</fdir1>
                <slip1>0.01</slip1>
                <slip2>0.01</slip2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://vibrant_terrain_export/terrain_red.dae</uri>
            </mesh>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- terrain_blue -->
    <model name="terrain_blue">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="terrain_blue_link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://vibrant_terrain_export/terrain_blue.dae</uri>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>10.0</mu>
                <mu2>10.0</mu2>
                <fdir1>1 0 0</fdir1>
                <slip1>0.9</slip1>
                <slip2>0.9</slip2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://vibrant_terrain_export/terrain_blue.dae</uri>
            </mesh>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- terrain_yellow -->
    <model name="terrain_yellow">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="terrain_yellow_link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://vibrant_terrain_export/terrain_yellow.dae</uri>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50.0</mu>
                <mu2>40.0</mu2>
                <fdir1>1 0 0</fdir1>
                <slip1>0.3</slip1>
                <slip2>0.3</slip2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://vibrant_terrain_export/terrain_yellow.dae</uri>
            </mesh>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Yellow</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- terrain_green -->
    <model name="terrain_green">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="terrain_green_link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://vibrant_terrain_export/terrain_green.dae</uri>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>80.0</mu>
                <mu2>70.0</mu2>
                <fdir1>1 0 0</fdir1>
                <slip1>0.05</slip1>
                <slip2>0.05</slip2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://vibrant_terrain_export/terrain_green.dae</uri>
            </mesh>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- terrain_base -->
    <model name="terrain_base">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="terrain_base_link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://vibrant_terrain_export/terrain_base.dae</uri>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>80.0</mu>
                <mu2>70.0</mu2>
                <fdir1>1 0 0</fdir1>
                <slip1>0.05</slip1>
                <slip2>0.05</slip2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://vibrant_terrain_export/terrain_base.dae</uri>
            </mesh>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Base</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>